# Paper Agent 配置示例 —— 复制为 .env 后填入真实值
# 注意：.env 已被 .gitignore 排除，不会提交

# ============================================================
# LLM 后端选择：deepseek / openai / anthropic / openai_compatible
#   deepseek          → DeepSeek（默认）
#   openai            → OpenAI
#   anthropic         → Anthropic Claude
#   openai_compatible → 任意 OpenAI 兼容服务（Qwen/GLM/Moonshot/Ollama 等）
# ============================================================
LLM_PROVIDER=deepseek

# ---- 通用 LLM 参数（可选） ----
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=3

# ---- DeepSeek（LLM_PROVIDER=deepseek 时使用） ----
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 官方推荐去掉 /v1（LangChain ChatDeepSeek 会自行拼接路径）
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- OpenAI / 兼容服务（LLM_PROVIDER=openai 或 openai_compatible 时使用） ----
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
#
# 例：阿里云百炼 Qwen
#   LLM_PROVIDER=openai_compatible
#   OPENAI_API_KEY=sk-...
#   OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
#   OPENAI_MODEL=qwen-plus
#
# 例：本地 Ollama
#   LLM_PROVIDER=openai_compatible
#   OPENAI_API_KEY=ollama
#   OPENAI_API_BASE=http://localhost:11434/v1
#   OPENAI_MODEL=qwen2.5:7b

# ---- Anthropic Claude（LLM_PROVIDER=anthropic 时使用） ----
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# ---- LangSmith 遥测（可选，免费） ----
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=paper_agent